# ==============================================================================
# SkyGuard AI — Environment Configuration Example
# ==============================================================================

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# MQTT Telemetry Broker Configuration (for ESP32 and IoT Sensor Ingest)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=skyguard

# Frontend Vite Proxy / WebSocket URL (Optional for custom overrides)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

